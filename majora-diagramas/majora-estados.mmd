%% Máscara de Majora interactiva - máquina de estados
%% Mantener sincronizado con majora-estados.svg y majora-estados.excalidraw
stateDiagram-v2
    direction LR
    state "DORMIDA · sin persona o más de 80 cm · servos 90°/90°" as DORMIDA
    state "DESPERTAR · persona a 30–80 cm · servos 65°/115°" as DESPERTAR
    state "POSESIÓN · persona a 30 cm o menos · servos alternan 45°/135°" as POSESION
    state "CALMA · se aleja y pasan 5 s · ojos regresan lentamente" as CALMA

    [*] --> DORMIDA
    DORMIDA --> DESPERTAR: 80 cm o menos
    DESPERTAR --> POSESION: 30 cm o menos
    POSESION --> DESPERTAR: más de 30 cm
    DESPERTAR --> CALMA: sin persona 5 s
    POSESION --> CALMA: se aleja 5 s
    CALMA --> DORMIDA: regreso lento
    DORMIDA --> DORMIDA: lectura inválida / posición segura 90°/90°

    note right of DORMIDA
      TRIG GPIO 5 · ECHO GPIO 18
      Servo izq GPIO 13 · Servo der GPIO 12
    end note
